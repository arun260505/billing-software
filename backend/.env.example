# InWallz Billing — backend configuration
#
# Copy this file to `.env` in the SAME folder (billing-software/backend/.env)
# and fill in your own MySQL password. `.env` is gitignored — never commit it.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / macOS:    cp .env.example .env

# Port the backend listens on. The frontend expects 5000 (see src/services/api.js).
PORT=5000

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# NOTE: the variable is DB_PASSWORD (not DB_PASS). backend/config/db.js reads
# process.env.DB_PASSWORD — naming it DB_PASS gives a silent auth failure.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=inwallz_billing
DB_PORT=3306

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Any long random string. It only has to be identical across restarts of THIS
# backend; changing it logs everyone out. Use your own value, not this one.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# A 500 normally answers with a flat sentence, and the real error (schema
# names, driver text) goes only to the server log. Set this to true on a DEV
# machine to see the detail in the HTTP response too. Leave it unset on a till
# or in the cloud.
# SHOW_INTERNAL_ERRORS=true
