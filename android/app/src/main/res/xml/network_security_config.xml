<?xml version="1.0" encoding="utf-8"?>
<!--
  The server address is entered by the user at runtime and differs per
  restaurant (192.168.0.x, 192.168.1.x, 10.x, …), so cleartext HTTP has to be
  permitted generally — Android's network-security-config cannot match a subnet
  range, only exact hosts. This is safe here: the app only ever speaks plain
  HTTP to a local server on the same WiFi; everything else still requires HTTPS
  by virtue of the URLs used.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
